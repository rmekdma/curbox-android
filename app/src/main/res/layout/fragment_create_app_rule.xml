<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_rules_add_rule"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/app_rules_rule_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/app_rules_allowed_minutes_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/allowance_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/group_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TimePicker
            android:id="@+id/start_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:timePickerMode="spinner" />

        <TimePicker
            android:id="@+id/end_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/active_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_rules_active"
            android:checked="true" />

        <CheckBox
            android:id="@+id/weekday_sunday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_sunday" />

        <CheckBox
            android:id="@+id/weekday_monday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_monday" />

        <CheckBox
            android:id="@+id/weekday_tuesday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_tuesday" />

        <CheckBox
            android:id="@+id/weekday_wednesday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_wednesday" />

        <CheckBox
            android:id="@+id/weekday_thursday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_thursday" />

        <CheckBox
            android:id="@+id/weekday_friday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_friday" />

        <CheckBox
            android:id="@+id/weekday_saturday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/app_rules_saturday" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_rule_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_rules_save_rule" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_rule_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_rules_delete_rule"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
